{
  "name": "jav-manager-app",
  "version": "1.0.0",
  "description": "本地番号/女优管理器（Capacitor 混合应用）",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "check": "node --check js/utils.js && node --check js/db.js && node --check js/app.js",
    "build": "echo '静态项目，无需构建，直接打包即可'",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "keywords": [
    "capacitor",
    "hybrid-app",
    "local-storage",
    "media-manager"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0"
  }
}
